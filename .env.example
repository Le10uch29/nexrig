# Optional. Without it the AI Expert uses the deterministic coordinator and says so in the UI.
# Server-side only — never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Optional model override for the AI Expert (default: claude-opus-5-5).
BUILDAI_AI_MODEL=

# FPS Data Engine admin token (server-side only, >= 24 characters). Without it every admin route
# (/api/admin/*, /admin/benchmarks) answers 503 and global benchmark data is read-only.
NEXRIG_ADMIN_TOKEN=

# Optional path of the local benchmark store used until a database is connected
# (default: .data/fps-benchmarks.json). Must be writable for imports.
NEXRIG_BENCHMARK_STORE=

# Supabase (production store for benchmarks). Next.js loads .env.local / .env.production — not
# .env.supabase. The URL may include /rest/v1. SUPABASE_SECRET_KEY is server-only: never prefix it
# with NEXT_PUBLIC_. Without a valid secret key the app falls back to the local file store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_KEY=
SUPABASE_SECRET_KEY=
# Force the local file store even when Supabase is configured (development): file
NEXRIG_BENCHMARK_BACKEND=
